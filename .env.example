# ─── AddisBet Demo MVP — Environment Variables ───────────
# Copy this file to .env and fill in real values.
# All values below are required unless marked optional.

# ─── Database (Supabase PostgreSQL) ─────────────────────
# Go to Supabase → Project Settings → Database → Connection string
# Use the "Connection pooling" URI (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ─── NextAuth.js ────────────────────────────────────────
# Set to your deployed URL (e.g. https://your-project.vercel.app)
# For local dev use http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-a-real-secret"

# ─── Supabase (for Realtime channels + optional Storage) ─
# Go to Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ─── The Odds API (optional) ───────────────────────────
# Sign up free at https://the-odds-api.com
# App runs fine on mock data if this is blank or missing
ODDS_API_KEY=""

# ─── Admin Seed Credentials ────────────────────────────
# Used by prisma/seed.ts to create the initial SUPER_ADMIN
ADMIN_SEED_EMAIL="admin@addisbet.demo"
ADMIN_SEED_PASSWORD="Admin123!"

# ─── Demo Mode Flag ────────────────────────────────────
# Must always be "true" for this demo build.
# Gates all money-related code paths.
DEMO_MODE="true"
